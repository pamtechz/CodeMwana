APP_NAME="CodeMwana"
APP_ENV=production
APP_URL=http://localhost/CodeMwana
APP_TIMEZONE=Africa/Lusaka
APP_DEBUG=false

# XAMPP / Hostinger MySQL settings
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=codemwana
DB_USERNAME=root
DB_PASSWORD=

# For local SQLite testing, set DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/codemwana.sqlite

# Optional isolated Piston-compatible execution service.
# CodeMwana runs MwanaCode, HTML, CSS, JavaScript, React, Next.js,
# Python and PHP without installing another application or using an API key.
# Configure this only when C, C++ and Go execution is required.
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
CODE_RUNNER_TIMEOUT=15
